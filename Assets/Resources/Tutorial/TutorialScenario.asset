    introLines:
    - speaker: 0
      text: "\u307E\u305A\u306F\u3082\u3046\u4E00\u56DE \u624B\u724C\u9078\u629E\u306E\u7DF4\u7FD2
        \u3092\u3057\u3088\u3063\u304B"
    - speaker: 0
      text: "13\u679A\u306E\u724C\u3092\u9078\u3093\u3067\u624B\u724C\u3092\u4F5C\u3063\u3066\u306D\u30FC"
    revealBoardAfterLineIndex: 0
    onHandFilledLines:
    - speaker: 0
      text: "\u3088\u30FC\u3057\u3067\u304D\u305F\u306D"
    - speaker: 0
      text: "\u307B\u3044\u3058\u3083\u6C7A\u5B9A\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066"
    onSelfManganLines:
    - speaker: 0
      text: "\u3088\u30FC\u3057\u3067\u304D\u305F\u306D"
    - speaker: 0
      text: "\u307B\u3044\u3058\u3083\u6C7A\u5B9A\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066"
    beforeBetLines: []
    onBattleStartLines:
    - speaker: 0
      text: "\u3058\u3083\u3042\u65E9\u901F\u5BFE\u5C40\u958B\u59CB\uFF01"
    - speaker: 0
      text: "\u4ECA\u5EA6\u306F\u30A2\u30BF\u30B7\u304B\u3089"
