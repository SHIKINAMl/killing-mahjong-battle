    introLines:
    - speaker: 0
      text: "\u6B21\u306E\u5C40\u3088\u3002\u300E\u81EA\u52D5\u300F\u3092\u62BC\u3057\u3066\u3002"
    revealBoardAfterLineIndex: 0
    onHandFilledLines: []
    onSelfManganLines: []
    beforeBetLines: []
    onBattleStartLines:
    - speaker: 0
      text: "\u2026\u2026\u3075\u3075\u3002\u6B63\u76F4\u306B\u8A00\u3046\u3068\u306D\u3001\u3061\u3087\u3063\u3068\u6016\u3044\u306E\u3002"
    - speaker: 0
      text: "\u3053\u306E\u307E\u307E\u6D41\u5C40\u3092\u7D9A\u3051\u3066\u3044\u305F\u3044\u304F\u3089\u3044\u3002"
    - speaker: 0
      text: "\u3060\u304B\u3089\u6559\u3048\u3066\u3042\u3052\u308B\u3002\u79C1\u306E\u5F85\u3061\u306F\u6771\u3088\u3002"
    - speaker: 0
      text: "\u6771\u3060\u3051\u306F\u7D76\u5BFE\u306B\u51FA\u3055\u306A\u3044\u3067\u306D\u3002"
    - speaker: 0
      text: "\u2026\u2026\u307B\u3089\u3002\u3061\u3083\u3093\u3068\u76EE\u3092\u898B\u3066\u8A00\u3063\u305F\u3067\u3057\u3087\u3046\uFF1F"
    beforeManualDiscardLines: []
    outroLines:
    - speaker: 0
      text: "\u30ED\u30F3\u3002"
    - speaker: 0
      text: "\u2026\u2026\u3075\u3075\u3063\u3001\u4FE1\u3058\u305F\u306E\uFF1F"
    - speaker: 0
      text: "\u5F85\u3061\u304C\u6771\u3060\u306A\u3093\u3066\u3001\u672C\u5F53\u3060\u3068\u306F\u4E00\u5EA6\u3082\u8A00\u3063\u3066\u3044\u306A\u3044\u308F\u3002"
    - speaker: 0
      text: "\u3055\u3063\u304D\u8A00\u3063\u305F\u308F\u3088\u306D\u3002\u81EA\u5206\u3067\u6C7A\u3081\u3066\u6255\u3063\u305F\u3001\u3063\u3066\u3002"
    - speaker: 0
      text: "\u9055\u3046\u308F\u3002\u6C7A\u3081\u3055\u305B\u3089\u308C\u3066\u3044\u305F\u306E\u3002"
    - speaker: 0
      text: "\u5358\u9A0E\u5F85\u3061\u306F\u3001\u305F\u3063\u305F1\u679A\u3092\u5F85\u3064\u4EE3\u308F\u308A\u306B\u2015\u2015\u76F8\u624B\u306E\u5931\u3046\u984D\u304C2\u500D\u306B\u306A\u308B\u306E\u3002"
    - speaker: 0
      text: "\u5F79\u6E80\u306F4\u500D\u3002\u305D\u306E2\u500D\u3060\u304B\u3089\u3001\u7A4D\u307E\u308C\u305F\u8840\u306E8\u500D\u306D\u3002"
    - speaker: 0
      text: "\u5168\u90E8\u3044\u305F\u3060\u304F\u308F\u3002"
    - speaker: 0
      text: "\u3042\u3089\u3001\u5951\u7D04\u66F8\u306B\u5782\u308C\u3061\u3083\u3063\u305F\u3002"
    - speaker: 0
      text: "\u7F72\u540D\u306E\u96A3\u306B\u3001\u70B9\u304C\u3072\u3068\u3064\u5897\u3048\u305F\u3060\u3051\u306D\u3002"
