    abilityIntroLines:
    - speaker: 0
      text: "\u624B\u724C\u304C\u6C7A\u307E\u3063\u305F\u308F\u306D\u3002\u3053\u3053\u304B\u3089\u304C\u672C\u756A\u3002"
    - speaker: 0
      text: "\u80FD\u529B\u304C\u4F7F\u3048\u308B\u306E\u306F\u3053\u306E\u624B\u724C\u30D5\u30A7\u30A4\u30BA\u306E\u9593\u3060\u3051\u3002\u6253\u724C\u304C\u59CB\u307E\u3063\u305F\u3089\u3001\u3082\u3046\u4F7F\u3048\u306A\u3044\u308F\u3002"
    - speaker: 0
      text: "\u898B\u305B\u3066\u3042\u3052\u308B\u3002\u3088\u304F\u898B\u3066\u3044\u306A\u3055\u3044\u3002"
    abilityShowcases:
    - skillType: perspective
      beforeLines:
      - speaker: 0
        text: "\u307E\u305A\u306F\u300E\u900F\u8996\u300F\u3002\u3042\u306A\u305F\u306E\u724C\u30923\u679A\u3001\u52DD\u624B\u306B\u8997\u304F\u306E\u3002"
