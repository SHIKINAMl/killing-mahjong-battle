    inheritedBetLines:
    - speaker: 0
      text: "\u524D\u306E\u5C40\u306F\u6D41\u308C\u305F\u308F\u306D\u3002\u8CED\u3051\u305F\u3076\u3093\u306F\u3001\u307E\u3060\u5353\u306E\u4E0A\u306B\u3042\u308B\u306E\u3002"
    - speaker: 0
      text: "\u4ECA\u56DE\u306F{0}\u5186\u304C\u81EA\u52D5\u3067\u7A4D\u307E\u308C\u3066\u3001\u5834\u306B\u306F\u5408\u8A08{1}\u5186\u3002\u6539\u3081\u3066\u8CED\u3051\u308B\u5FC5\u8981\u306F\u306A\u3044\u308F\u3002"
    - speaker: 0
      text: "\u8AB0\u3082\u52DD\u3063\u3066\u3044\u306A\u3044\u306E\u306B\u3001\u5353\u306E\u4E0A\u306E\u8840\u3060\u3051\u304C\u5897\u3048\u3066\u3044\u304F\u306E\u3088\u3002"
    - speaker: 0
      text: "\u7A4D\u307E\u308C\u305F\u5206\u3060\u3051\u3001\u6B21\u306B\u4E0A\u304C\u3063\u305F\u307B\u3046\u306E\u53D6\u308A\u5206\u304C\u5927\u304D\u304F\u306A\u308B\u3002"
