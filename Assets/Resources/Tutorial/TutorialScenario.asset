    onBattleStartLines:
    - speaker: 0
      text: "\u3057\u3070\u3089\u304F\u9ED9\u3063\u3066\u898B\u3066\u3044\u306A\u3055\u3044\u3002\u52DD\u624B\u306B\u9032\u3081\u308B\u308F\u3002"
    beforeManualDiscardLines:
    - speaker: 0
      text: "\u304A\u4E92\u304417\u724C\u6368\u3066\u305F\u3089\u3001\u305D\u306E\u5C40\u306F\u6D41\u308C\u308B\u3002"
    - speaker: 0
      text: "\u3042\u30682\u56DE\u3088\u3002\u597D\u304D\u306A\u306E\u3092\u6368\u3066\u306A\u3055\u3044\u3002"
    outroLines:
    - speaker: 0
      text: "\u6D41\u5C40\u3002\u8AB0\u3082\u4E0A\u304C\u3089\u306A\u3044\u307E\u307E\u724C\u304C\u5C3D\u304D\u305F\u308F\u3002"
    - speaker: 0
      text: "\u8AB0\u3082\u6B7B\u306A\u306A\u304B\u3063\u305F\u308F\u306D\u3002"
    - speaker: 0
      text: "\u305D\u308C\u3067\u3082\u3001\u629C\u304B\u308C\u305F\u8840\u306F\u5353\u306E\u4E0A\u306B\u3042\u308B\u306E\u3088\u3002"
    - speaker: 0
      text: "\u6C7A\u7740\u3057\u3066\u3044\u306A\u3044\u3093\u3060\u304B\u3089\u3001\u8CED\u3051\u91D1\u306F\u8AB0\u306E\u3082\u306E\u306B\u3082\u306A\u3089\u306A\u3044\u3002"
    - speaker: 0
      text: "\u3060\u304B\u3089\u6B21\u306E\u5C40\u306B\u7A4D\u307E\u308C\u308B\u306E\u3002"
    - speaker: 0
      text: "\u2026\u2026\u3044\u3044\uFF1F \u5EF6\u3070\u3057\u305F\u5206\u3060\u3051\u3001\u6B21\u306B\u6C7A\u307E\u308B\u3068\u304D\u304C\u91CD\u304F\u306A\u308B\u306E\u3088\u3002"
    - speaker: 0
      text: "\u6D41\u5C40\u306F\u3001\u52A9\u304B\u3063\u305F\u3093\u3058\u3083\u306A\u3044\u308F\u3002"
    - speaker: 0
      text: "\u652F\u6255\u3044\u3092\u3001\u5148\u306B\u5EF6\u3070\u3057\u305F\u3060\u3051\u3002"
