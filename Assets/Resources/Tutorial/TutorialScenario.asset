  defeatRon:
    meldBaseIds: 010000000100000001000000020000000200000002000000030000000300000003000000040000000400000004000000
    yakuList:
    - "四暗刻"
    formulaText: "役満"
    rankText: "役満"
    deadEndRonLines:
    - speaker: 0
      text: "そ・れ・ローン"
    revealRonLines:
    - speaker: 0
      text: "アナタ絶望的に先輩には甘いわよね？"
    assaultExplainLines:
    - speaker: 0
      text: "アタシが対局前に使った能力……強襲"
    - speaker: 0
      text: "それは相手を狩るための力"
    - speaker: 0
      text: "本来アタシがロンして得るはずの点数をそのまま相手へのダメージに変換する"
    deadEndAssaultFinalLines:
    - speaker: 0
      text: "アタシの獲得点数{0}をそのまま食らってもらうよ！"
    revealAssaultFinalLines:
    - speaker: 0
      text: "さよならねおバカさん？"
  revival:
    enemyLines:
    - speaker: 0
      text: "<b>\u30A2\u30C3\u30CF\u30C3\u30CF\u30C3\u30CF</b>"
    - speaker: 0
      text: "\u3044\u3064\u3084\u3063\u3066\u3082\u3068\u3069\u3081\u306E\u77AC\u9593\u304C\u305F\u307E\u3089\u306A\u3044\u308F"
    - speaker: 0
      text: "\u3058\u3083\u3042\u6557\u3051\u305F\u30A2\u30CA\u30BF\u306E\u9B42\u3092\u9802\u3053\u3046\u304B\u3057\u3089\u306D"
    monologueLines:
    - speaker: 2
      text: "\u76EE\u306E\u524D\u304C\u771F\u3063\u6697\u306B\u306A\u3063\u305F"
    - speaker: 2
      text: "\u3082\u3046\u4F53\u306F\u52D5\u304B\u306A\u3044\n\u306A\u306B\u3082\u3067\u304D\u306A\u3044"
    - speaker: 2
      text: "\u9B42\u3092\u596A\u308F\u308C\u308B\u3068\u306F\u304D\u3063\u3068\u3053\u3046\u3044\u3046\u3053\u3068\u306A\u306E\u3060\u308D\u3046"
    - speaker: 2
      text: "\u2026\u2026\u2026\u2026\u2026\u2026"
    - speaker: 2
      text: "\u2026\u2026\u2026\u2026\u2026\u2026"
    - speaker: 2
      text: "\u2026\u2026\u2026\u2026\u2026\u3093\uFF1F"
    skillName: "\u5FA9\u6D3B"
    beruruLines:
    - speaker: 0
      text: "\u3053\u308C\u3067\u5951\u7D04\u3092\u679C\u305F\u3057\u305F"
    - speaker: 0
      text: "\u3042\u3068\u306F\u5F8C\u8F29\u3061\u3083\u3093\u304C\u52D9\u3081\u3092\u679C\u305F\u305B"
    - speaker: 0
      text: "\u30A2\u30BF\u30B7\u306E\u4EE3\u308F\u308A\u306B\u3042\u306E\u5438\u8840\u9B3C\u3092\u5012\u3059\u3093\u3060"
