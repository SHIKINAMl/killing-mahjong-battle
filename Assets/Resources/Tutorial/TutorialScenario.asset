        text: "\u6700\u5F8C\u306F\u300E\u5F79\u5F37\u5316\u300F\u3002\u6C7A\u3081\u305F\u5F79\u306E\u7FFB\u6570\u3092+1\u3059\u308B\u306E\u3002"
