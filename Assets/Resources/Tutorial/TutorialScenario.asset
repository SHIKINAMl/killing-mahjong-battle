    onHighBetLines:
    - speaker: 0
      text: "うわーギャンブラーだねー"
    onMiddleBetLines:
    - speaker: 0
      text: "手堅いねー"
    afterFreeBetLines:
    - speaker: 0
      text: "よし自分で賭けられたね"
    beforeEnemyAssaultLines:
    - speaker: 0
      text: "あっ！アタシも能力使うの忘れてた"
    - speaker: 0
      text: "ホントはダメだけど…今アタシ教えてるから\nいいよねっ？"
    enemyDiscardBaseIds: 12000000130000001400000015000000160000001700000018000000190000001a0000000000000001000000020000000300000004000000050000000600000007000000
