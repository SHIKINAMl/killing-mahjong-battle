    - speaker: 0
      text: "13\u679A\u305D\u308D\u3063\u305F\u308F\u306D\u3002\u305D\u306E\u624B\u3067\u672C\u5F53\u306B\u3044\u3044\u306E\uFF1F"
    - speaker: 0
      text: "\u6C7A\u3081\u305F\u306A\u3089\u300E\u6C7A\u5B9A\u300F\u3092\u3002\u8FF7\u3046\u306A\u3089\u300E\u81EA\u52D5\u300F\u3092\u3002"
    onSelfManganLines: []
    beforeBetLines: []
    onBattleStartLines:
    - speaker: 0
      text: "\u624B\u304C\u6C7A\u307E\u3063\u305F\u3002\u3082\u3046\u5F15\u304D\u8FD4\u305B\u306A\u3044\u308F\u3002"
    - speaker: 0
      text: "\u3053\u3053\u304B\u3089\u5148\u306B\u8CED\u304B\u3063\u3066\u3044\u308B\u306E\u306F\u3001\u304A\u91D1\u3058\u3083\u306A\u3044\u3002"
    - speaker: 0
      text: "\u4E00\u679A\u6253\u3064\u305F\u3073\u306B\u3001\u3069\u3061\u3089\u304B\u304C\u6E1B\u308B\u306E\u3088\u3002"
    - speaker: 0
      text: "\u2026\u2026\u306D\u3048\u3002"
    - speaker: 0
      text: "\u3072\u3068\u3064\u3060\u3051\u6559\u3048\u3066\u3042\u3052\u308B\u3002"
    - speaker: 0
      text: "\u79C1\u3082\u3001\u3042\u306A\u305F\u3068\u540C\u3058\u3060\u3051\u629C\u304B\u308C\u3066\u3044\u308B\u306E\u3088\u3002"
    - speaker: 0
      text: "\u3055\u3042\u3001\u59CB\u3081\u307E\u3057\u3087\u3046\u3002\u9707\u3048\u308B\u624B\u3067\u9078\u3073\u306A\u3055\u3044\u3002"
    beforeManualDiscardLines: []
    outroLines:
    - speaker: 0
      text: "\u2026\u2026\u4E5D\u84EE\u5B9D\u71C8\u3002"
    - speaker: 0
      text: "\u3057\u304B\u3082\u4E5D\u9762\u5F85\u3061\u3067\u3059\u3063\u3066\u2026\u2026\uFF01\uFF1F"
