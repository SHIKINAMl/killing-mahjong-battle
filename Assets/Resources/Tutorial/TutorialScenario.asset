      - speaker: 0
        text: "\u307B\u3089\u3001\u5370\u304C\u3064\u3044\u305F\u3067\u3057\u3087\u3046\u3002\u305D\u306E3\u679A\u306F\u79C1\u306B\u4E38\u898B\u3048\u3088\u3002"
      perspectiveTileCount: 3
      boostYakuName: 
      boostHan: 1
    - skillType: mulligan
