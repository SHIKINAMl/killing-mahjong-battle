    - speaker: 0
      text: "\u3053\u308C\u304C\u5F79\u4E00\u89A7\u3088\u3002\u5F79\u3054\u3068\u306E\u7FFB\u6570\u3068\u3001\u5F37\u5316\u3055\u308C\u305F\u5206\u304C\u4E26\u3093\u3067\u3044\u308B\u308F\u3002"
    - speaker: 0
      text: "\u3055\u3063\u304D\u79C1\u304C\u5F37\u5316\u3057\u305F\u300E\u6E05\u4E00\u8272\u300F\u3082\u4E57\u3063\u3066\u3044\u308B\u3067\u3057\u3087\u3046\uFF1F"
