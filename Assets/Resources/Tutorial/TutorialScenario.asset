        text: "\u300E\u6E05\u4E00\u8272\u300F\u3092\u9078\u3093\u3060\u308F\u3002\u540C\u3058\u624B\u3067\u3082\u6253\u70B9\u304C\u8DF3\u306D\u4E0A\u304C\u308B\u3002"
