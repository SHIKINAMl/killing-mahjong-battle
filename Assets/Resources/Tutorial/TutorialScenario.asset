    introLines:
    - speaker: 0
      text: "\u5951\u7D04\u306F\u6E08\u3093\u3060\u308F\u306D\u3002"
    - speaker: 0
      text: "\u305D\u306E\u5951\u7D04\u66F8\u3001\u307E\u3060\u4E7E\u3044\u3066\u3044\u306A\u3044\u3067\u3057\u3087\u3046\u3002"
    - speaker: 0
      text: "\u2026\u2026\u30A4\u30F3\u30AF\uFF1F \u9055\u3046\u308F\u3002\u3042\u306A\u305F\u306E\u8272\u3088\u3002"
    - speaker: 0
      text: "\u3042\u3042\u3042\u3042\u3042\u3042\u3042\u3042\u3042\u3042\u3042"
    - speaker: 0
      text: "\u5C71\u724C\u304B\u308913\u679A\u9078\u3073\u306A\u3055\u3044\u3002\u305D\u308C\u304C\u3042\u306A\u305F\u306E\u547D\u306E\u5024\u6BB5\u306B\u306A\u308B\u308F\u3002"
    revealBoardAfterLineIndex: -1
    onHandFilledLines:
    - speaker: 0
      text: "13\u679A\u306D\u3002\u2026\u2026\u305D\u306E\u624B\u3001\u6E80\u8CAB\u306B\u3082\u5C4A\u3044\u3066\u3044\u306A\u3044\u308F\u3002"
    - speaker: 0
      text: "\u5B89\u3044\u624B\u3067\u5EA7\u308B\u306E\u306F\u8A31\u3055\u306A\u3044\u3002\u6B7B\u306C\u5024\u6253\u3061\u304C\u306A\u3044\u3082\u306E\u3002"
    - speaker: 0
      text: "\u4ECA\u56DE\u306F\u7D44\u3093\u3067\u3042\u3052\u308B\u3002\u300E\u81EA\u52D5\u300F\u3092\u62BC\u3057\u306A\u3055\u3044\u3002"
    onSelfManganLines:
    - speaker: 0
      text: "\u2026\u2026\u3042\u3089\u3002\u3061\u3083\u3093\u3068\u6E80\u8CAB\u306B\u5C4A\u3044\u3066\u308B\u3002"
    - speaker: 0
      text: "\u9EBB\u96C0\u3092\u77E5\u3063\u3066\u3044\u308B\u624B\u306D\u3002\u5C11\u3057\u697D\u3057\u304F\u306A\u3063\u3066\u304D\u305F\u308F\u3002"
    - speaker: 0
      text: "\u6587\u53E5\u306F\u306A\u3044\u308F\u3002\u300E\u6C7A\u5B9A\u300F\u3092\u62BC\u3057\u306A\u3055\u3044\u3002"
    beforeBetLines:
    - speaker: 0
      text: "\u6B21\u306F\u8CED\u3051\u91D1\u3088\u3002"
    - speaker: 0
      text: "\u8A00\u3063\u3066\u304A\u304F\u3051\u3069\u3001\u6C7A\u3081\u305F\u5206\u306E\u8840\u306F\u305D\u306E\u5834\u3067\u629C\u304B\u308C\u308B\u308F\u3002"
    - speaker: 0
      text: "\u52DD\u3063\u3066\u304B\u3089\u6255\u3046\u3093\u3058\u3083\u306A\u3044\u3002\u8CED\u3051\u305F\u77AC\u9593\u306B\u3001\u3082\u3046\u6E1B\u3063\u3066\u3044\u308B\u306E\u3002"
    - speaker: 0
      text: "\u4F53\u529B\u30B2\u30FC\u30B8\u3001\u6C7A\u3081\u305F\u77AC\u9593\u306B\u6E1B\u308B\u306E\u3092\u898B\u3066\u3044\u306A\u3055\u3044\u3002"
    - speaker: 0
      text: "\u623B\u3063\u3066\u304F\u308B\u304B\u3069\u3046\u304B\u306F\u3001\u307E\u3060\u4F55\u3082\u6C7A\u307E\u3063\u3066\u3044\u306A\u3044\u3051\u308C\u3069\u3002"
    - speaker: 0
      text: "\u52DD\u3066\u3070\u5F79\u306E\u500D\u7387\u3092\u304B\u3051\u3066\u8FD4\u308B\u3002\u8CA0\u3051\u308C\u3070\u3001\u6255\u3063\u305F\u4E0A\u306B\u3082\u3063\u3068\u6301\u3063\u3066\u3044\u304B\u308C\u308B\u3002"
    - speaker: 0
      text: "\u3044\u304F\u3089\u51FA\u3059\uFF1F \u81EA\u5206\u3067\u6C7A\u3081\u3066\u3044\u3044\u306E\u3088\u3002"
    onBattleStartLines:
    - speaker: 0
      text: "\u5BFE\u5C40\u958B\u59CB\u3088\u3002"
    - speaker: 0
      text: "\u3042\u306A\u305F\u306E\u756A\u3002\u597D\u304D\u306A\u724C\u3092\u6368\u3066\u3066\u3054\u3089\u3093\u306A\u3055\u3044\u3002"
    - speaker: 0
      text: "\u4E00\u679A\u305A\u3064\u3001\u4EA4\u4E92\u306B\u6253\u3063\u3066\u3044\u304F\u306E\u3002"
    beforeManualDiscardLines: []
    outroLines:
    - speaker: 0
      text: "\u30ED\u30F3\u3002\u3042\u306A\u305F\u306E\u4E0A\u304C\u308A\u306D\u3002"
    - speaker: 0
      text: "\u7372\u5F97\u306F\u300E\u81EA\u5206\u304C\u8CED\u3051\u305F\u984D \xD7
        \u5F79\u306E\u500D\u7387\u300F\u3002\u8DF3\u6E80\u306A\u30891.5\u500D\u3002"
    - speaker: 0
      text: "\u8CA0\u3051\u305F\u307B\u3046\u306F\u300E\u81EA\u5206\u304C\u8CED\u3051\u305F\u984D
        \xD7 \u76F8\u624B\u306E\u500D\u7387\u300F\u3092\u5931\u3046\u3002"
    - speaker: 0
      text: "\u2026\u2026\u305D\u308C\u3067\u306D\u3002\u6E80\u8CAB\u306F\u30011\u500D\u306A\u306E\u3002"
    - speaker: 0
      text: "\u52DD\u3063\u3066\u3082\u3001\u6255\u3063\u305F\u5206\u304C\u623B\u3063\u3066\u304F\u308B\u3060\u3051\u3002"
    - speaker: 0
      text: "\u6C17\u3065\u3044\u305F\uFF1F \u6E80\u8CAB\u3067\u52DD\u3063\u3066\u3082\u3001\u3042\u306A\u305F\u306F1\u6EF4\u3082\u5897\u3048\u3066\u3044\u306A\u3044\u306E\u3002"
    - speaker: 0
      text: "\u5927\u304D\u304F\u8CED\u3051\u3066\u3001\u5927\u304D\u304F\u7372\u308B\u3002\u305D\u308C\u3057\u304B\u5897\u3048\u308B\u9053\u306F\u306A\u3044\u308F\u3002"
