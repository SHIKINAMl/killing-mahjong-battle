      - speaker: 0
        text: "\u6B21\u306F\u300E\u724C\u4EA4\u63DB\u300F\u3002\u8981\u3089\u306A\u3044\u724C\u3092\u5C71\u3068\u5165\u308C\u66FF\u3048\u308B\u308F\u3002"
