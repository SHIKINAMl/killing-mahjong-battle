    abilityExplainLines:
    - speaker: 0
      text: "\u3053\u308C\u304C\u80FD\u529B\u3088\u3002\u4F7F\u3048\u3070\u5BFE\u5C40\u3092\u4E00\u6C17\u306B\u3072\u3063\u304F\u308A\u8FD4\u305B\u308B\u3002"
    - speaker: 0
      text: "\u4EE3\u511F\u306F\u3042\u306A\u305F\u306E\u8840\u3002\u4F53\u529B\u305D\u306E\u3082\u306E\u3088\u3002"
    - speaker: 0
      text: "\u79C1\u306E\u30B2\u30FC\u30B8\u3001\u898B\u3066\u3054\u3089\u3093\u306A\u3055\u3044\u3002"
    - speaker: 0
      text: "\u2026\u2026\u3055\u3063\u304D\u306E\u534A\u5206\u3082\u6B8B\u3063\u3066\u3044\u306A\u3044\u3067\u3057\u3087\u3046\uFF1F"
    - speaker: 0
      text: "\u306A\u3042\u306B\u3001\u305D\u306E\u9854\u3002"
    - speaker: 0
      text: "\u5F37\u304F\u306A\u308B\u306E\u306B\u4F55\u3082\u6255\u308F\u306A\u3044\u65B9\u6CD5\u304C\u3042\u308B\u3068\u601D\u3063\u305F\uFF1F"
    - speaker: 0
      text: "\u4F7F\u3048\u308B\u306E\u306F\u624B\u724C\u30D5\u30A7\u30A4\u30BA\u306E\u9593\u3060\u3051\u3002\u4F7F\u3046\u306A\u3089\u4ECA\u3088\u3002"
    - speaker: 0
      text: "\u80FD\u529B\u306F\u753B\u9762\u306E\u300E\u80FD\u529B\u300F\u30DC\u30BF\u30F3\u304B\u3089\u78BA\u8A8D\u3067\u304D\u308B\u308F\u3002"
    enhanceExplainLines:
    - speaker: 0
      text: "\u305D\u308C\u3068\u3001\u80FD\u529B\u305D\u306E\u3082\u306E\u3092\u5F37\u5316\u3059\u308B\u3053\u3068\u3082\u3067\u304D\u308B\u306E\u3002"
    - speaker: 0
      text: "\u300E\u5F79\u5F37\u5316\u300F\u3067\u7A4D\u3093\u3060\u7FFB\u6570\u306F\u3001\u305D\u306E\u5F79\u306B\u305A\u3063\u3068\u4E57\u308A\u7D9A\u3051\u308B\u308F\u3002"
    - speaker: 0
      text: "\u3069\u306E\u5F79\u304C\u3069\u308C\u3060\u3051\u80B2\u3063\u3066\u3044\u308B\u304B\u306F\u3001\u5F79\u4E00\u89A7\u3067\u898B\u306A\u3055\u3044\u3002"
    guideToYakuList: 1
