    introLines:
    - speaker: 0
      text: "\u300C\u304A\u3063\u5F8C\u8F29\u3061\u3083\u3093\u3058\u3083\u30FC\u3093\u300D"
    - speaker: 0
      text: "\u300C\u5148\u8F29\u3092\u52A9\u3051\u306B\u6765\u305F\u3093\u3060\u306A\uFF1F\u3048\u3089\u3044\u305E\u30FC\u300D"
    - speaker: 0
      text: "\u300C\u3075\u3093\u3075\u3093\u2026\u2026\u9B3C\u6C17\u8FEB\u3063\u305F\u30E1\u30FC\u30EB\u306B\u3044\u3066\u3082\u305F\u3063\u3066\u3082\u3044\u3089\u308C\u306A\u304F\u306A\u3063\u305F\u300D"
    - speaker: 0
      text: "\u300C\u2026\u2026\u3063\u3066\u30A2\u30BF\u30B7\u306E\u3053\u3068\u597D\u304D\u3059\u304E\u304B\u3088\u30FC\uFF01\uFF01\u300D"
    - speaker: 0
      text: "\u300C\u2026\u2026\u307E\u3063\u5F8C\u8F29\u3061\u3083\u3093\u304C\u4ECA\u304B\u3089\u3084\u308B\u306E\u306F\u305D\u3093\u306A\u751F\u3084\u3055\u3057\u3044\u3082\u3093\u3058\u3083\u306A\u3044\u3093\u3060\u3051\u3069\u306D\u300D"
    - speaker: 0
      text: "\u300C\u30E9\u30C1\u3089\u308C\u305F\u6642\u306B\u30C1\u30E9\u30C3\u3068\u898B\u305F\u304B\u3068\u601D\u3046\u3051\u3069\u3001\u3053\u3053\u306F\u8CED\u5834\u2026\u30AE\u30E3\u30F3\u30D6\u30EB\u3092\u3059\u308B\u3068\u3053\u306A\u3093\u3060\u300D"
    - speaker: 0
      text: "\u300C\u3057\u304B\u3082\u305F\u3060\u306E\u30AE\u30E3\u30F3\u30D6\u30EB\u3058\u3083\u306A\u3044\u2026\u2026\u305D\u308C\u306F\u547D\u304C\u3051\u306E\u30AE\u30E3\u30F3\u30D6\u30EB\uFF01\uFF01\u300D"
    - speaker: 0
      text: "\u300C\u306A\u306B\u306A\u306B\u2026\u2026\u5165\u53E3\u3067\u5951\u7D04\u66F8\u3092\u66F8\u304B\u3055\u308C\u305F\u6642\u304B\u3089\u899A\u609F\u306F\u3057\u3066\u305F\u300D"
    - speaker: 0
      text: "\u300C\u2026\u2026\u3063\u3066\u5951\u7D04\u66F8\uFF01\uFF1F\u30A2\u30BF\u30B7\u306F\u305D\u3093\u306A\u306E\u66F8\u304B\u306A\u304B\u3063\u305F\u3051\u3069\u300D"
    - speaker: 0
      text: "\u300C\u30D3\u30D3\u3089\u305D\u3046\u3068\u601D\u3063\u3066\u30DB\u30E9\u5439\u3044\u305F\u3051\u3069\u305D\u3063\u3061\u306E\u307B\u3046\u304C\u6016\u3044\u306A\u300D"
    - speaker: 0
      text: "\u300C\u307E\u3063\u9577\u304F\u306A\u3063\u3061\u3083\u3063\u305F\u304B\u3089\u65E9\u901F\u30EB\u30FC\u30EB\u8AAC\u660E\u3059\u308B\u308F\u300D"
    - speaker: 0
      text: "\u300C\u5927\u4E08\u592B\uFF01\u6BBA\u3057\u5408\u3044\u3068\u304B\u3057\u306A\u3044\u304B\u3089\u3055\uFF01\u4F55\u56DE\u304B\u30AE\u30E3\u30F3\u30D6\u30EB\u3067\u304D\u308C\u3070\u30A2\u30BF\u30B7\u305F\u3061\u306F\u8131\u51FA\u3067\u304D\u308B\u3063\u3066\u30EF\u30B1\u300D"
    - speaker: 0
      text: "\u300C\u4E00\u4EBA\u3067\u3053\u3053\u306B\u30AB\u30C1\u30B3\u3093\u3060\u304B\u3089\u76F8\u624B\u3044\u306A\u304B\u3063\u305F\u3093\u3060\u3088\u306D\u2026\u300D"
    - speaker: 0
      text: "\u300C\u305D\u308C\u3058\u3083\u306F\u3058\u3081\u308B\u3088\u300D"
    - speaker: 0
      text: "\u300C\u3053\u3053\u3067\u306F\u7279\u6B8A\u306A\u9EBB\u96C0\u3092\u30D7\u30EC\u30A4\u3057\u3066\u30AE\u30E3\u30F3\u30D6\u30EB\u3092\u3057\u3066\u3044\u304F\u3088\u300D"
    revealBoardAfterLineIndex: 13
    onHandFilledLines:
    - speaker: 0
      text: "\u3042\u30FC\u305D\u308C\u306F\u9055\u3046\u306D"
    - speaker: 0
      text: "\u307E\u3041\u96E3\u3057\u3044\u3057\u3001\u3057\u3083\u3042\u306A\u3044\u304B"
    - speaker: 0
      text: "\u3058\u3083\u3042\u3001\u30B3\u30EC\u4F7F\u3063\u3066\u3088"
    - speaker: 0
      text: "\u3053\u308C\u306F \u304A\u307E\u304B\u305B\u30DC\u30BF\u30F3"
    - speaker: 0
      text: "\u81EA\u52D5\u3067\u5C71\u724C\u306E\u4E2D\u304B\u3089\u6E80\u8CAB\u4EE5\u4E0A\u306E\u5F62\u3092\u4F5C\u3063\u3066\u304F\u308C\u308B\u3088"
    - speaker: 0
      text: "君はまだできないみたいだからこれを押して"
    onSelfManganLines:
    - speaker: 0
      text: "\u304A\u3063\u304D\u3063\u3061\u308A\u3067\u304D\u305F\u306D"
    - speaker: 0
      text: "\u3055\u3059\u304C\u306F\u5F8C\u8F29\u3061\u3083\u3093 \u98F2\u307F\u8FBC\u307F\u65E9\u3044\u306D\u30FC"
    - speaker: 0
      text: "\u3058\u3083\u3042\u307E\u3041\u3044\u3089\u306A\u3044\u3068\u601D\u3046\u3051\u3069"
    beforeBetLines:
    - speaker: 0
      text: "\u3042\u3063\uFF01\u305D\u306E\u524D\u306B\u8CED\u3051\u91D1\u306E\u8A2D\u5B9A\u3092\u3057\u306A\u304D\u3083\u306D"
    - speaker: 0
      text: "\u3042\u3068\u3067\u8AAC\u660E\u3059\u308B\u304B\u3089\u4ECA\u56DE\u306F2000\u8CED\u3051\u3066\u304F\u308C\u308B\u304B\u306A"
    onBattleStartLines: []
    beforeManualDiscardLines: []
    outroLines: []
  - label: "\u7B2C2\u5C40 \u6D41\u5C40"
    wallBaseIds: 09000000090000000a0000000a0000000b0000000b0000000d0000000d0000000d0000000f0000001000000012000000130000001400000015000000160000001700000018000000190000001a0000000000000001000000020000000300000004000000050000000600000007000000080000001b0000001b0000001b0000001c0000001c000000
