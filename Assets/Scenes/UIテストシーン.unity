    Dialogue1: "\u3042\u3089\u3001\u8D64\u30C9\u30E9\u3092\u6368\u3066\u308B\u306A\u3093\u3066\u3002\u81EA\u5206\u306E\u624B\u306B\u306F\u7D44\u307F\u8FBC\u3081\u306A\u304B\u3063\u305F\u306E\u306D\u3002"
    Dialogue2: 
  - Condition: "\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u30AA\u30BF\u98A8\u3092\u5207\u3063\u305F\u6642"
