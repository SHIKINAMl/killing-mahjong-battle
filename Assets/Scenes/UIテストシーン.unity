--- !u!114 &803083764
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 803083763}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87c2d75c7b0842241bd14e263cf14ef6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KillingMahjong.Managers.DialogueManager
  parsedDialogues:
  - Condition: "\u76F8\u624B\u304C\u7B2C\uFF11\u5C40\u76EE\u3067\u5148\u884C"
    Expression: "\u901A\u5E38\u9854"
    Dialogue1: "\u307E\u3001\u521D\u56DE\u3050\u3089\u3044\u306F\u30EF\u30BF\u30B7\u304C\u30A2\u30BF\u30EA\u724C\u306E\u907F\u3051\u65B9\u3092\u898B\u305B\u3066\u3042\u3052\u307E\u3059\u308F\u306D"
    Dialogue2: 
  - Condition: "\u76F8\u624B\u304C\u7B2C\u4E00\u5C40\u76EE\u3067\u5F8C\u653B"
    Expression: "\u30D4\u30FC\u30B9\u30AD\u30E1\u9854"
    Dialogue1: "\u3069\u3046\u305E\u3001\u7D33\u58EB\u7684\u306A\u4E00\u624B\u3092\u304A\u9858\u3044\u3057\u307E\u3059\u308F\u3002\u3044\u304D\u306A\u308A\u632F\u308A\u8FBC\u307E\u306A\u3044\u3067\u306D\uFF1F"
    Dialogue2: 
  - Condition: "\u76F8\u624B\u304C\u7B2C\u4E00\u5C40\u76EE\u3067\u5408\u308F\u305B(\u6575\u306E\u76F4\u524D\u306E\u6253\u724C\u540C\u3058\u724C\u3092\u6253\u3064\u3053\u3068)\u3092\u884C\u3046"
    Expression: "\u30AD\u30E1\u9854"
    Dialogue1: "\u30A2\u30CA\u30BF\u306E\u6253\u724C\u306B\u540C\u3058\u724C\u3092\u5F53\u3066\u308B\u30B3\u30C8\u2026\u73FE\u7269\u5408\u308F\u305B\u3002"
    Dialogue2: "\u3053\u308C\u3053\u305D\u304C\u3053\u306E\u30B2\u30FC\u30E0\u306E\u7D76\u5BFE\u5B89\u5168\u724C\u3088\u3002"
  - Condition: "\u81EA\u5206\u304C\u7B2C\u4E00\u5C40\u76EE\u3067\u521D\u3081\u3066\u5408\u308F\u305B\u3092\u884C\u3046"
    Expression: "\u30AD\u30E1\u9854"
    Dialogue1: "\u30EF\u30BF\u30B7\u306E\u6253\u724C\u306B\u5168\u304F\u540C\u3058\u724C\u3092\u5F53\u3066\u305F\u2026!"
    Dialogue2: "\u3075\u3045\u3093\u3001\u73FE\u7269\u3067\u3057\u3063\u304B\u308A\u51CC\u3050\u3064\u3082\u308A\u306D"
  - Condition: "\u521D\u3081\u3066\u9650\u5EA6\u984D\u3044\u3063\u3071\u3044\u307E\u3067\u8CED\u3051\u305F\u6642\u306E\u958B\u5E55\u306E\u30BB\u30EA\u30D5"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u3042\u3089\u3042\u3089\u3002\u8840\u6C17\u76DB\u3093\u3060\u30B3\u30C8\u2026"
    Dialogue2: "\u3088\u3063\u307D\u3069\u9AD8\u3044\u624B\u3067\u5F35\u3063\u3066\u308B\u307F\u305F\u3044\u306D"
  - Condition: "\u521D\u3081\u3066\u6700\u5C0F\u5358\u4F4D\u3067\u8CED\u3051\u305F\u6642\u306E\u958B\u5E55\u306E\u30BB\u30EA\u30D5"
    Expression: "\u30D4\u30FC\u30B9\u717D\u308A\u9854"
    Dialogue1: "\u3075\u3075\u3075\u3002\u30A2\u30CA\u30BF\u3001\u8CED\u3051\u4E8B\u306F\u521D\u3081\u3066\uFF1F"
    Dialogue2: "\u3053\u306E\u30D2\u30EA\u3064\u304F\u30D7\u30EC\u30C3\u30B7\u30E3\u30FC\u306B\u3001\u5C0F\u9E7F\u306E\u3088\u3046\u306B\u9707\u3048\u3066\u308B\u308F"
  - Condition: "\u521D\u3081\u3066\u6D41\u5C40\u3057\u305F\u6642\u306E\u6700\u5F8C\u306E\u30BB\u30EA\u30D5"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u304A\u4E92\u304417\u56DE\u3057\u306E\u3044\u3060\u308F\u306D\u3002\u6D41\u5C40\u2026\u2026\u30AC\u30DE\u30F3\u6BD4\u3079\u307F\u305F\u3044\uFF1F"
    Dialogue2: "\u3055\u3042\u3001\u3082\u3046\u4E00\u5EA6\u540C\u3058\u91CF\u3092\u8CED\u3051\u306A\u3055\u3044"
  - Condition: "\u521D\u3081\u3066\u4E00\u4E5D\u5B57\u724C\u3092\u5207\u3063\u305F\u6642\u306E\u30BB\u30EA\u30D5"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u307E\u3041\u5B89\u30D1\u30A4\u3088\u306D\u3002\u78BA\u7387\u7684\u306B\u306F\u3002"
    Dialogue2: "\u3067\u3082\u7AEF\u724C\u306E\u30D2\u30C3\u30AB\u30B1\u306A\u3093\u3066\u3088\u304F\u3042\u308B\u8A71\u3088\uFF1F"
  - Condition: "\u521D\u3081\u30662-8\u306E\u724C\u3092\u3092\u5207\u3063\u305F\u6642\u306E\u30BB\u30EA\u30D5"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u30ED\u30F3\u3063\u3066\u8A00\u3044\u305F\u304F\u306A\u308B\u724C\u306D\uFF1F"
    Dialogue2: "\u672C\u547D\u306E\u30A2\u30BF\u30EA\u724C\u304B\u3082\u3088\uFF1F"
  - Condition: "1\u5C40\u76EE\u306E\u30B2\u30FC\u30E0\u958B\u59CB\u6642"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u3055\u3042\u3001\u547D\u3092\u61F8\u3051\u305F\u7A76\u6975\u306E\u9EBB\u96C0\u306E\u59CB\u307E\u308A\u3067\u3059\u308F\u3002"
    Dialogue2: 
  - Condition: "2\u5C40\u76EE\u4EE5\u964D\u306E\u958B\u5E55\u6642"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u307E\u3060\u3084\u308B\u6C17\u306A\u306E\uFF1F\u5F80\u751F\u969B\u304C\u60AA\u3044\u3067\u3059\u308F\u306D\u3002"
    Dialogue2: 
  - Condition: "\u30D7\u30EC\u30A4\u30E4\u30FC\u306EHP\u304C\u6B8B\u308A\u308F\u305A\u304B\u306A\u6642\u306E\u958B\u5E55"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u6B21\u3067\u30C8\u30C9\u30E1\u306D\u3002\u632F\u308A\u8FBC\u3080\u899A\u609F\u306F\u3067\u304D\u3066\u308B\u304B\u3057\u3089\uFF1F"
    Dialogue2: 
  - Condition: "\u6575\u306EHP\u304C\u6B8B\u308A\u308F\u305A\u304B\u306A\u6642\u306E\u958B\u5E55"
    Expression: "\u901A\u5E38\u9854"
    Dialogue1: "\u304F\u3063\u2026\u2026\u307E\u3060\u3088\u3001\u3053\u3053\u304B\u3089\u5DFB\u304D\u8FD4\u3057\u3066\u3042\u3052\u308B\u308F\uFF01"
    Dialogue2: 
  - Condition: "\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u5727\u5012\u7684\u6709\u5229\u306A\u6642\u306E\u958B\u5E55"
    Expression: "\u901A\u5E38\u9854"
    Dialogue1: "\u307E\u3050\u308C\u3067\u30A2\u30BF\u30EA\u724C\u3092\u8EB1\u3057\u3066\u308B\u304B\u3089\u3063\u3066\u3001\u8ABF\u5B50\u306B\u4E57\u3089\u306A\u3044\u3067\u3088\u306D\u3002"
    Dialogue2: 
  - Condition: "\u6575\u304C\u5727\u5012\u7684\u6709\u5229\u306A\u6642\u306E\u958B\u5E55"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u3075\u3075\u3063\u3001\u5727\u5012\u7684\u3058\u3083\u306A\u3044\u3002\u3082\u3046\u8AE6\u3081\u305F\u3089\u3069\u3046\uFF1F"
    Dialogue2: 
  - Condition: "\u30D7\u30EC\u30A4\u30E4\u30FC\u306EHP\u304C0\u306B\u306A\u3063\u305F\u6642"
    Expression: "\u30D4\u30FC\u30B9\u30AD\u30E1\u9854"
    Dialogue1: "\u306F\u3044\u3001\u30B2\u30FC\u30E0\u30AA\u30FC\u30D0\u30FC\u2661
      \u30A2\u30CA\u30BF\u306E\u8CA0\u3051\u3088\u3002"
    Dialogue2: 
  - Condition: "\u6575\u306EHP\u304C0\u306B\u306A\u3063\u305F\u6642"
    Expression: "\u901A\u5E38\u9854"
    Dialogue1: "\u30A6\u30BD\u2026\u2026\u30EF\u30BF\u30B7\u304C\u3001\u8CA0\u3051\u308B\u306A\u3093\u3066\u2026\u2026\uFF01"
    Dialogue2: 
  - Condition: "\u6D41\u5C40\u304C2\u56DE\u4EE5\u4E0A\u7D9A\u3044\u305F\u6642"
    Expression: "\u901A\u5E38\u9854"
    Dialogue1: "\u9000\u5C48\u306A\u6642\u9593\u2026\u2026\u305D\u308D\u305D\u308D\u6C7A\u7740\u3092\u3064\u3051\u307E\u3057\u3087\u3046\uFF1F"
    Dialogue2: 
  - Condition: "\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u5373\u5EA7\u306B\u9650\u5EA6\u984D\u3092\u8CED\u3051\u305F\u6642"
    Expression: "\u901A\u5E38\u9854"
    Dialogue1: "\u8FF7\u3044\u304C\u306A\u3044\u308F\u306D\u3002\u2026\u2026\u7834\u6EC5\u9858\u671B\u3067\u3082\u3042\u308B\u306E\uFF1F"
    Dialogue2: 
  - Condition: "\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u524D\u306E\u5C40\u3067\u8CA0\u3051\u305F\u306E\u306B\u9650\u5EA6\u984D\u3092\u8CED\u3051\u305F\u6642"
    Expression: "\u717D\u308A\u9854"
    Dialogue1: "\u30E0\u30AD\u306B\u306A\u3063\u3066\u308B\u308F\u306D\u3002\u30AB\u30E2\u306E\u5178\u578B\u3060\u308F\u3002"
    Dialogue2: 
  - Condition: "\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u5C11\u984D\u3057\u304B\u8CED\u3051\u306A\u304B\u3063\u305F\u6642"
    Expression: "\u30D4\u30FC\u30B9\u717D\u308A\u9854"
