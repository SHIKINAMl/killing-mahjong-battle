    Dialogue1: "\u52DD\u8CA0\u306B\u51FA\u308B\u306E\u306D\u3002\u305D\u306E\u5EA6\u80F8\u3060\u3051\u306F\u8912\u3081\u3066\u3042\u3052\u308B\u3002"
