    Dialogue1: "\u65E9\u3044\u308F\u306D\u3002\u9069\u5F53\u306B\u7D44\u3093\u3060\u306E\uFF1F\u305D\u308C\u3068\u3082\u2026\u2026\u5B8C\u74A7\u306A\u30C6\u30F3\u30D1\u30A4\u3092\u7D44\u3081\u305F\u306E\u304B\u3057\u3089\uFF1F"
