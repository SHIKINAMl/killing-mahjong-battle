    Pose: 
    Expression: "\u30D4\u30FC\u30B9\u717D\u308A\u9854"
    Dialogue1: "\u30D3\u30D3\u3063\u3066\u308B\u306E\uFF1F\u5C0F\u9E7F\u307F\u305F\u3044\u3067\u53EF\u611B\u3044\u3067\u3059\u308F\u3002"
